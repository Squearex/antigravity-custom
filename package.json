{
  "name": "antigravity-sx",
  "productName": "Antigravity Pro",
  "version": "2.15.1",
  "description": "Antigravity - Agentic Desktop Application",
  "homepage": "https://antigravity.google",
  "author": {
    "name": "Google",
    "email": "antigravity-support@google.com"
  },
  "main": "dist/main.js",
  "scripts": {
    "build:inject": "esbuild src/index.js --bundle --outfile=dist/sx-inject.js --platform=browser --target=es2022 --jsx=automatic --jsx-import-source=preact",
