    "@connectrpc/connect-node": "^2.1.2",
    "@floating-ui/dom": "^1.8.0",
    "chrome-devtools-mcp": "^1.1.0",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.9",
    "preact": "^10.29.8",
    "shell-env": "^4.0.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
